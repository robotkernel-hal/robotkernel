services:
  - name: robotkernel/kernel/config_dump_log
    request:
      max_len: { type: uint32_t, default: 1024 }
      do_ust: { type: bool, default: false }
      set_loglevel: { type: string, default: "info" }
    response:
      current_loglevel: { type: string }
      error_message: { type: string, default: "no error" }
